{
  "name": "Reproduction Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "PYTHON_VERSION": "3.11"
    }
  },
  "runArgs": [
    "--cpus=2",
    "--memory=4g",
    "--gpus=device=0",
    "-p", "8888:8888"
  ],
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "vscode"
}